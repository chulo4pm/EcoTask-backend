# Copy this file to .env and fill in your own values.
# On Render, add these under Environment instead (the .env file is not uploaded).

PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ecotask
# 32+ random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email - Brevo (needed on Render; Render's free plan blocks Gmail SMTP)
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@gmail.com

# Email - Gmail (works on your own computer)
EMAIL_USER=
EMAIL_PASS=
